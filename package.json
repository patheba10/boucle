{
  "name": "boucle",
  "version": "0.44.0",
  "private": true,
  "type": "module",
  "description": "Plateforme d'apprentissage : Python, C++, data, Git, hardware et roadmaps métier.",
  "scripts": {
    "dev": "python3 -m http.server 5173 --directory public",
    "validate": "node scripts/validate.mjs",
    "test:e2e": "python3 -m pytest -q tests/e2e",
    "precache": "node scripts/precache.mjs",
    "audit": "node scripts/audit.mjs",
    "test:unit": "node --test 'tests/unit/**/*.test.mjs'"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "js-yaml": "4.3.2",
    "JSCPP": "2.0.6"
  }
}
